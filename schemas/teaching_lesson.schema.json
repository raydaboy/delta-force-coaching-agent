{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/delta-force-coaching/teaching-lesson.schema.json",
  "title": "Evidence-backed gameplay teaching lesson",
  "type": "object",
  "required": ["lesson_id", "source_fight_id", "lesson_type", "novelty_label", "decision_point", "observed", "inferred", "unknown", "what_helped", "what_hurt", "realistic_alternative", "next_game_cue", "drill"],
  "properties": {
    "lesson_id": {"type":"string","minLength":1},
    "source_fight_id": {"type":"string","minLength":1},
    "lesson_type": {"enum":["decision","mechanic","position","resource","goal_tradeoff","progression"]},
    "novelty_label": {"enum":["new_lesson","progression","repeated_mistake","different_version","model_success","no_review"]},
    "goal_relation": {"type":"string","minLength":1},
    "review_depth": {"enum":["micro_bridge","standard","deep","no_review"]},
    "decision_point": {"type":"object","required":["source_time","description","evidence_refs"],"properties":{"source_time":{"type":"number","minimum":0},"description":{"type":"string","minLength":1},"evidence_refs":{"type":"array","minItems":1,"items":{"type":"string"}}},"additionalProperties":true},
    "observed": {"type":"array","minItems":1,"items":{"type":"string","minLength":1}},
    "inferred": {"type":"array","items":{"type":"string","minLength":1}},
    "unknown": {"type":"array","minItems":1,"items":{"type":"string","minLength":1}},
    "what_helped": {"type":"string","minLength":1},
    "what_hurt": {"type":"string","minLength":1},
    "realistic_alternative": {"type":"object","required":["action","tradeoff","likely_benefit","unknowns"],"properties":{"action":{"type":"string","minLength":1},"tradeoff":{"type":"string","minLength":1},"likely_benefit":{"type":"string","minLength":1},"unknowns":{"type":"array","items":{"type":"string"}}},"additionalProperties":true},
    "next_game_cue": {"type":"string","minLength":1},
    "drill": {"type":"object","required":["name","trigger","action","success_condition","scope"],"properties":{"name":{"type":"string","minLength":1},"trigger":{"type":"string","minLength":1},"action":{"type":"string","minLength":1},"success_condition":{"type":"string","minLength":1},"scope":{"type":"string","minLength":1}},"additionalProperties":true}
  },
  "additionalProperties": true
}
