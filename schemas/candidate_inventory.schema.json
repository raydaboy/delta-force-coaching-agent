{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Raw Candidate Inventory",
  "type": "object",
  "required": ["source", "events"],
  "properties": {
    "source": {"type": "object"},
    "player_goal": {"type": "object"},
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["event_id", "start", "end", "type_guess", "summary", "evidence"],
        "properties": {
          "event_id": {"type": "string", "minLength": 1},
          "start": {"type": "number", "minimum": 0},
          "end": {"type": "number", "minimum": 0},
          "type_guess": {"type": "string"},
          "summary": {"type": "string"},
          "location_id": {"type": "string"},
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["kind", "strength", "claim"],
              "properties": {
                "kind": {"type": "string"},
                "strength": {"type": "number", "minimum": 0, "maximum": 1},
                "claim": {"type": "string"}
              }
            }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
